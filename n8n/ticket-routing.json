{
  "name": "SupportDesk - Alert Routing",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "supportdesk/ticket-alert",
        "responseMode": "onReceived"
      },
      "id": "webhook",
      "name": "Ticket Alert Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "supportdesk-ticket-alert"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return items.map(item => ({ json: item.json.body ?? item.json }));"
      },
      "id": "normalize",
      "name": "Read Flask Ticket Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.priority}}",
              "operation": "equals",
              "value2": "high"
            }
          ]
        }
      },
      "id": "priority",
      "name": "High Priority?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [740, 300]
    },
    {
      "parameters": {
        "channel": "support-alerts",
        "text": "=High-priority ticket {{$json.id}}: {{$json.title}}"
      },
      "id": "slack",
      "name": "Alert Support",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [980, 180]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return items;"
      },
      "id": "low-log",
      "name": "Log Low Priority",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [980, 420]
    }
  ],
  "connections": {
    "Ticket Alert Webhook": {
      "main": [
        [
          {
            "node": "Read Flask Ticket Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Flask Ticket Event": {
      "main": [
        [
          {
            "node": "High Priority?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "High Priority?": {
      "main": [
        [
          {
            "node": "Alert Support",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Low Priority",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
